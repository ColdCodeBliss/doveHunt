{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "DoveHuntWidgetExtension.entitlements" },
    { "kind": "folder", "path": "doveHunt", "target-membership": [ "doveHunt" ] },
    {
      "kind": "folder",
      "path": "DoveHuntWidget",
      "target-membership": [
        "DoveHuntWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "DoveHuntWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "DoveHuntWidgetExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "DoveHuntWidgetExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/doveHunt.app", "id": "1C802FE130ABF40C007A7B81", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/DoveHuntWidgetExtension.appex", "id": "1C802FF230ABF73A007A7B81", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "doveHunt/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
    { "kind": "folder", "path": "Markdowns" },
    { "kind": "folder", "path": "Shared", "target-membership": [ "DoveHuntWidgetExtension", "doveHunt" ] },
  ],
  "targets": [
